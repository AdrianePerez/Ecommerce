# Copie para .env.local e preencha com os dados do projeto Supabase
# (Painel do Supabase → Project Settings → API). Estas duas são públicas por natureza:
# a segurança dos dados vem das políticas RLS no banco.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon

# NUNCA coloque aqui a service_role key: ela ignora a RLS e só pode existir no servidor.
